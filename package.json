{
	"name": "ejv",
	"version": "2.2.1",
	"description": "Easy JSON Validator",
	"exports": {
		".": {
			"import": {
				"types": "./build/esm/index.d.ts",
				"default": "./build/esm/index.js"
			},
			"require": {
				"types": "./build/index.d.ts",
				"default": "./build/cjs/index.js"
			}
		}
	},
	"types": "build/index.d.ts",
	"main": "build/cjs/index.js",
	"files": [
		"build/*.d.ts",
		"build/cjs",
		"build/esm",
		"README-KR.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rimraf ./build",
		"prebuild": "yarn clean",
		"build:types": "tsc -p tsconfig.types.json",
		"build:cjs": "tsc -p tsconfig.cjs.json",
		"build:esm": "tsc -p tsconfig.esm.json",
		"build": "yarn build:types&&yarn build:cjs&&yarn build:esm",
		"postbuild": "tsc -p tsconfig.scripts.json&&node build/scripts/add-js-extensions&&node build/scripts/create-package-json",
		"test": "mocha",
		"lint": "eslint"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/han41858/ejv.git"
	},
	"keywords": [
		"json",
		"validator",
		"validation"
	],
	"author": "Janghyun Han <han41858@gmail.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/han41858/ejv/issues"
	},
	"homepage": "https://github.com/han41858/ejv#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "26.6.5",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"chai": "^6.3.0",
		"eslint": "^10.13.0",
		"eslint-plugin-chai-friendly": "^1.2.1",
		"globals": "^17.13.0",
		"mocha": "^12.0.3",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2"
	}
}
