{
	"compilerOptions": {
		"rootDir": ".",
		"target": "ES2022",
		"lib": [
			"ESNext"
		],
		"types": [
			"node"
		],
		"sourceMap": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		"spec",
		"scripts"
	]
}
